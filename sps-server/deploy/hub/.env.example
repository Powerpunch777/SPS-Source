# Copy this file to .env with Initialize-SPSHubDeployment.ps1. Never commit .env.
SPS_DOMAIN=hub.example.com
SPS_PUBLIC_URL=https://hub.example.com
SPS_POSTGRES_PASSWORD=replace-with-generated-url-safe-secret
SPS_BETTER_AUTH_SECRET=replace-with-generated-url-safe-secret
SPS_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
SPS_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# Needed only when starting the Cloudflare Tunnel deployment mode.
# SPS_CLOUDFLARE_TUNNEL_TOKEN=replace-with-remotely-managed-tunnel-token
# Optional image override for a deliberate cloudflared version pin.
# SPS_CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
