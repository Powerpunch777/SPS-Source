{
  "name": "sps-plugin-discovery",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Bundled SPS Plugin Builder tool provider.",
  "files": [
    "dist",
    "sps-plugin.json"
  ],
  "spsPlugin": {
    "id": "sps.plugin-discovery",
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "npm run build && node --test ./test/*.test.mjs && node ./scripts/verify-manifest.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.8"
  }
}
