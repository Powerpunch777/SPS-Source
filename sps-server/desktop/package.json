{
  "name": "@sps/desktop",
  "private": true,
  "version": "0.1.7",
  "description": "SPS Desktop Hub and Node onboarding shell",
  "author": "SonParkServer",
  "main": "src/main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "prepare:host-runtime": "node scripts/prepare-local-host-runtime.mjs",
    "package:win": "npm run prepare:host-runtime && electron-builder --win nsis",
    "release:win": "npm run prepare:host-runtime && electron-builder --win nsis --config.forceCodeSigning=true --publish always"
  },
  "dependencies": {
    "@sps/desktop-node": "file:../desktop-node",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.sps.desktop",
    "productName": "SPS Desktop",
    "asar": true,
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "icon": "assets/sps-logo.png",
    "extraResources": [
      {
        "from": ".host-runtime",
        "to": "sps-host-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Powerpunch777",
        "repo": "SPS",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
