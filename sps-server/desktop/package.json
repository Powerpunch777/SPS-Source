{
  "name": "@sps/desktop",
  "private": true,
  "version": "0.4.117",
  "description": "SPS Desktop Owner Host and Member Node collaboration app",
  "author": "SonParkServer",
  "main": "src/main.mjs",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-electron-runtime.mjs",
    "sync:desktop-node": "node scripts/sync-local-desktop-node.mjs",
    "docs:candidate": "node scripts/current-candidate-doc.mjs",
    "docs:candidate:check": "node scripts/current-candidate-doc.mjs --check",
    "audit:release": "node scripts/security-audit.mjs",
    "prestart": "npm run sync:desktop-node",
    "start": "electron .",
    "pretest": "npm run sync:desktop-node",
    "test": "node --test test/*.test.mjs",
    "test:e2e:bootstrap": "npm run sync:desktop-node && node scripts/smoke-isolated-desktop-ui.mjs",
    "test:e2e:workspace-surfaces": "npm run sync:desktop-node && node scripts/smoke-workspace-surfaces-desktop.mjs",
    "test:e2e:plugin-preview": "npm run sync:desktop-node && node scripts/smoke-plugin-preview-desktop.mjs",
    "test:e2e:host-plugin-lifecycle": "npm run sync:desktop-node && node scripts/smoke-host-plugin-lifecycle-desktop.mjs",
    "release:init-device-key": "node scripts/initialize-physical-device-key.mjs",
    "release:sign-device-evidence": "node scripts/sign-physical-release-evidence.mjs",
    "prepare:owner-host-runtime": "npm run sync:desktop-node && node scripts/prepare-owner-host-runtime.mjs",
    "smoke:owner-host-runtime": "node scripts/smoke-packaged-owner-host-runtime.mjs",
    "smoke:marketplace-mcp-runtime": "node scripts/smoke-packaged-marketplace-mcp-runtime.mjs",
    "smoke:packaged-marketplace-mcp-runtime": "node scripts/smoke-packaged-marketplace-mcp-runtime.mjs --packaged",
    "smoke:plugin-preview-runtime": "node scripts/smoke-plugin-preview-runtime.mjs",
    "stage:agent-runtime-packs": "node scripts/stage-agent-runtime-packs.mjs",
    "archive:agent-runtime-packs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/archive-agent-runtime-packs.ps1",
    "verify:packaged-owner-host-runtime": "node scripts/verify-packaged-owner-host-runtime.mjs",
    "package:win": "npm run prepare:owner-host-runtime && electron-builder --win nsis && node scripts/write-update-metadata.mjs && npm run stage:agent-runtime-packs && npm run archive:agent-runtime-packs && npm run verify:packaged-owner-host-runtime && npm run smoke:packaged-marketplace-mcp-runtime && node scripts/create-release-manifest.mjs",
    "release:win": "npm run prepare:owner-host-runtime && electron-builder --win nsis --config.forceCodeSigning=true --publish never && node scripts/write-update-metadata.mjs && npm run stage:agent-runtime-packs && npm run archive:agent-runtime-packs && npm run verify:packaged-owner-host-runtime && npm run smoke:packaged-marketplace-mcp-runtime && node scripts/create-release-manifest.mjs",
    "package:candidate:win": "npm run prepare:owner-host-runtime && electron-builder --win nsis --publish never && node scripts/write-update-metadata.mjs && npm run stage:agent-runtime-packs && npm run archive:agent-runtime-packs && npm run verify:packaged-owner-host-runtime && npm run smoke:packaged-marketplace-mcp-runtime && node scripts/create-release-manifest.mjs"
  },
  "dependencies": {
    "@sonparkserver/plugin-sdk": "file:../../external/sps-plugin-sdk",
    "@sps/desktop-node": "file:../desktop-node",
    "electron-updater": "6.8.9",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.sps.desktop",
    "productName": "SPS Desktop",
    "asar": true,
    "compression": "normal",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".owner-host-runtime-package",
        "to": "sps-owner-host-runtime-package"
      }
    ],
    "icon": "assets/sps-logo.png",
    "artifactName": "SPS-Desktop-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Powerpunch777",
        "repo": "SPS-Desktop-Releases",
        "releaseType": "release",
        "channel": "latest"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "useZip": false,
      "differentialPackage": false
    }
  }
}
