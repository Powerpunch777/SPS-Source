{
  "name": "@sps/desktop",
  "private": true,
  "version": "0.4.80",
  "description": "SPS Desktop Owner Host and Member Node collaboration app",
  "author": "SonParkServer",
  "main": "src/main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "prepare:owner-host-runtime": "node scripts/prepare-owner-host-runtime.mjs",
    "smoke:owner-host-runtime": "node scripts/smoke-packaged-owner-host-runtime.mjs",
    "package:win": "npm run prepare:owner-host-runtime && electron-builder --win nsis && node scripts/create-release-manifest.mjs",
    "release:win": "npm run prepare:owner-host-runtime && electron-builder --win nsis --config.forceCodeSigning=true --publish never && node scripts/create-release-manifest.mjs",
    "package:candidate:win": "npm run prepare:owner-host-runtime && electron-builder --win nsis --publish never && node scripts/create-release-manifest.mjs"
  },
  "dependencies": {
    "@sps/desktop-node": "file:../desktop-node",
    "@sonparkserver/plugin-sdk": "file:../../external/sps-plugin-sdk",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.sps.desktop",
    "productName": "SPS Desktop",
    "asar": true,
    "compression": "normal",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".owner-host-runtime",
        "to": "sps-owner-host-runtime",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      },
      {
        "from": ".owner-host-runtime/node_modules",
        "to": "sps-owner-host-runtime/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "icon": "assets/sps-logo.png",
    "artifactName": "SPS-Desktop-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Powerpunch777",
        "repo": "SPS-Desktop-Releases",
        "releaseType": "release",
        "channel": "latest"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
